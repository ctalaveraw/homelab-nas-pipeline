##  ISO configuration

proxmox_iso_checksum = "4fce7c02a5e5dbe3426da4aa0f8b7845e9a36aff29c5884d206a08e51b2c4c47" # This is the checksum of the ISO used for the template (required)
# proxmox_iso_storage_pool = "" # This is the location where Proxmox will store the VM ISO image (uncomment and define if not default location of "local")

## ISO path configuration

proxmox_ubuntu_iso_version = "24.10" # This is the version of Ubuntu used in the URL of the ISO Image used for this template
# OR
# proxmox_ubuntu_iso_local_path = "" # This is the local path of the ISO Image used for the template

## HTTP server configuration

http_host_ip = "10.69.69.170" # This is the IP of the current machine used for the temporary HTTP server for hosting cloud-init script
# http_host_port = "" # This is the open port on the current machine used for the temporary HTTP server for hosting cloud-init script (uncomment and define if port 8021 is blocked)

## Proxmox VM configuration


proxmox_vm_template_name = "TEMPLATE-NAS-PROD" # This is the name of the VM Template that will be created
# proxmox_vm_disk_storage_pool = "" # This is the location where Proxmox will store the VM hard disk (uncomment and define if not using "local-zfs")

## Proxmox connection configuration

proxmox_target_node = "tva" # This is the name of the destination "node" on Proxmox
proxmox_api_url = "https://10.69.69.200:8006/api2/json"  # This is the Proxmox server's API endpoint, format is "https://{PROXMOX_IP}:{PROXMOX_PORT}/api2/json"
proxmox_api_token_id = "root@pam!connector_packer" # This is the API Token ID, format is "root@pam!{TOKEN_NAME}"
proxmox_api_token_secret = "c5dab301-697f-4e31-b795-a1c9a15ba15f" # This is the API Token Secret, format is "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

## SSH configuration

proxmox_ssh_username = "lifeless" # This is the username used for SSH connections between the current machine and the Proxmox VE machine

# proxmox_ssh_password = "" # This is the password for the username used for SSH connections between the current machine and the Proxmox VE machine
# OR
proxmox_ssh_keyfile_path = "~/.ssh/hosts/homelab/proxmox/host/connector-packer" # This is the path of the authorized key used for SSH connections between the current machine and the Proxmox VE machine



